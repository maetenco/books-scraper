# Telegram Bot (obtén token de @BotFather en Telegram)
# 1. Crea un bot en Telegram con @BotFather y obtén el token
# 2. Envía un mensaje a tu bot desde Telegram
# 3. Visita https://api.telegram.org/bot<TU_TOKEN>/getUpdates
#    para obtener tu CHAT_ID
TELEGRAM_BOT_TOKEN=tu_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui
